<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>TomlToObject</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>Carl W. Irving</Authors>
        <Title>Toml-To-Object</Title>
        <Description>Extension for the directory-to-object package to support loading of TOML files in directories.</Description>
        <Product>TomlToObject</Product>
        <AssemblyOriginatorKeyFile>..\toml-to-object.snk</AssemblyOriginatorKeyFile>
        <SignAssembly>true</SignAssembly>
        <PackageId>toml-to-object</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/cwirving/toml-to-object-dotnet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/cwirving/toml-to-object-dotnet.git</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="directory-to-object" Version="0.3.1"/>
        <PackageReference Include="Tomlyn.Signed" Version="2.10.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\toml-to-object.snk">
            <Link>toml-to-object.snk</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
